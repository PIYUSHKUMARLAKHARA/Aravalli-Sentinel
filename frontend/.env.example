# Frontend Environment Configuration
VITE_API_URL=/api

# Optional: Google Maps JavaScript API Key
# If omitted or invalid, Aravalli Sentinel automatically falls back to Leaflet & Esri World Imagery
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Firebase Client Configuration
# If omitted, the frontend operates seamlessly via backend demo authentication and local store
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=aravalli-sentinel
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
