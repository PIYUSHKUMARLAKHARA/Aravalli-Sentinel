rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthority() {
      return isAuthenticated() && (
        request.auth.token.role == 'authority' || 
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@(forest|env|pcb|gov)\\.in$')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reports collection
    match /reports/{reportId} {
      // Public / citizens can read reports (with client/server redacting sensitive fields)
      allow read: if true;

      // Authenticated citizens can create reports, but status MUST be 'pending'
      // and they cannot fake risk calculations or authority audit logs
      allow create: if isAuthenticated() &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.citizenId == request.auth.uid;

      // Only verified environmental authority can update status or append audit logs
      allow update: if isAuthority();

      // Deleting reports is strictly prohibited to preserve regulatory chain-of-custody
      allow delete: if false;
    }

    // Ecological Zones collection
    match /zones/{zoneId} {
      // Public read access for maps and citizen dashboards
      allow read: if true;

      // Only authorized authority can update zone risk factors or boundaries
      allow write: if isAuthority();
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users cannot elevate their own role to 'authority'
      allow create, update: if isOwner(userId) && 
                            (!('role' in request.resource.data) || request.resource.data.role == 'citizen');
    }
  }
}
