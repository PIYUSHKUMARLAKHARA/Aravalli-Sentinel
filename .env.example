# =============================================================================
# ARAVALLI SENTINEL: GOOGLE COMMUNITY CONTEST EDITION — WORKSPACE ENV TEMPLATE
# =============================================================================

# Server & Network Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/aravalli_sentinel
DATABASE_TYPE=mongodb

# Authentication & Cryptographic Tokens
JWT_SECRET=aravalli_sentinel_super_secure_jwt_secret_token_2026_contest
AUTHORITY_INVITE_SECRET=AravalliEnforce2026SecureContestSecret
DEMO_BOOTSTRAP_ENABLED=true

# Google Gemini 1.5 Pro / Flash Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Earth Engine & Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=
EARTH_ENGINE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=

# Google Maps Platform / WeatherNext API Configuration
WEATHER_API_KEY=
GOOGLE_WEATHER_API_KEY=

# Storage & File Configuration
MAX_FILE_UPLOAD_MB=50
STORAGE_CONFIGURATION=local

# Data Provider Execution Mode: 'live' or 'demo'
ENVIRONMENTAL_DATA_MODE=demo
GEOSPATIAL_PROVIDER=sentinel-hub-simulator
