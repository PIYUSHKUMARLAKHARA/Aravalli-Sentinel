# ==============================================================================
# ARAVALLI SENTINEL — Master Environment Configuration Template
# ==============================================================================
# This template documents all environment variables used across the project.
# To configure your local development environment:
#   1. Copy this file to backend/.env and frontend/.env:
#        cp .env.example backend/.env
#        cp .env.example frontend/.env
#   2. Customize the values as needed.
#
# NOTE: The platform is designed with a High-Fidelity Demonstration Fallback mode.
# If external keys (Gemini, Firebase, Google Maps) are omitted, the application
# runs out-of-the-box with local simulation stores and fallback map tiles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------

# Server Listening Port (Required, Default: 5050)
PORT=5050

# Application Environment Mode (Required: 'development' | 'production' | 'test')
NODE_ENV=development

# Allowed Frontend Origin for CORS (Required, Default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (backend/.env)
# ------------------------------------------------------------------------------

# Google AI Studio API Key for multimodal evidence analysis and Ask Aravalli chat.
# Obtain a key from: https://aistudio.google.com/app/apikey
# (Optional in local development; if empty, server automatically uses rule-guided ecological heuristics)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Optional, Default: gemini-2.0-flash)
# Supported models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK & STORAGE (backend/.env)
# ------------------------------------------------------------------------------

# Firebase Project Identifier (Required, Default: aravalli-sentinel-demo)
FIREBASE_PROJECT_ID=aravalli-sentinel-demo

# Path to the downloaded Firebase service account JSON key file (Optional)
# If provided, the server initializes live Firebase Firestore and Cloud Storage.
# If omitted or invalid, the server automatically uses an in-memory/disk development store.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternatively, pass the raw JSON stringified service account credentials (Optional)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Authority Registration Secret Token (Required for official role provisioning)
# Used by administrators to provision verified Forest Department and Task Force accounts.
AUTHORITY_INVITE_SECRET=AravalliEnforce2025SecureToken

# ------------------------------------------------------------------------------
# 4. GEOSPATIAL & TELEMETRY PROVIDER (backend/.env)
# ------------------------------------------------------------------------------

# Telemetry Data Mode (Optional: 'demo' | 'live', Default: demo)
ENVIRONMENTAL_DATA_MODE=demo

# Active Geospatial Provider Implementation (Optional, Default: sentinel-hub-simulator)
GEOSPATIAL_PROVIDER=sentinel-hub-simulator

# Google Earth Engine Credentials (Optional / Planned for live satellite ingestion)
# GEE_SERVICE_ACCOUNT=your-gee-service-account@project.iam.gserviceaccount.com
# GEE_API_KEY=your_gee_api_key_here

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------

# Base URL for backend REST API proxying (Required, Default: /api)
VITE_API_URL=/api

# Google Maps JavaScript API Key (Optional)
# Obtain from: https://console.cloud.google.com/google/maps-apis
# If omitted, the frontend automatically falls back to Leaflet with Esri World Satellite
# and CartoDB Dark Matter topographic tiles.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Web Client SDK Configuration (Optional - for direct client authentication)
# If omitted, the frontend operates seamlessly through backend authentication routes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=aravalli-sentinel-demo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
