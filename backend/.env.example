# Aravalli Sentinel Backend Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gemini API
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Firebase Admin SDK Configuration
# Option 1: Path to serviceAccountKey.json file downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option 2: JSON stringified service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Project ID
FIREBASE_PROJECT_ID=aravalli-sentinel

# MongoDB Database Configuration (Optional / Recommended for persistent storage)
# Supports local MongoDB daemon or MongoDB Atlas cloud cluster:
#   Local: mongodb://localhost:27017/aravalli_sentinel
#   Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/aravalli_sentinel?retryWrites=true&w=majority
# If left empty, backend falls back gracefully to High-Fidelity Local Store.
MONGODB_URI=
DATABASE_TYPE=mongodb

# Authority Registration Secret Token (Used by admins to provision authority accounts)
# Keep this secure on the server! Never expose this key in frontend code or commit to source control.
AUTHORITY_INVITE_SECRET=AravalliEnforce2025SecureToken

# Pre-Authorized Forest Authority Officer Provisioning (Optional Setup via Environment)
# Use these environment variables to provision the initial Forest Authority Officer.
# The server will automatically create this account on startup if it does not already exist.
# Never commit actual credentials to version control.
INITIAL_OFFICER_NAME=
INITIAL_OFFICER_EMAIL=
INITIAL_OFFICER_PASSWORD=

# JWT Session Secret
# Generate a cryptographically strong random string (minimum 32 characters)
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_here

# Demo Bootstrap Administrator Toggle (true in local dev / hackathon demos; set to false in production)
# When true, seeds the evaluation officer account (officer.sharma@forest.haryana.gov.in)
DEMO_BOOTSTRAP_ENABLED=true

# Data Provider Mode: 'live' or 'demo'
ENVIRONMENTAL_DATA_MODE=demo
GEOSPATIAL_PROVIDER=sentinel-hub-simulator
