# Aravalli Sentinel Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gemini API
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Firebase Admin SDK Configuration
# Option 1: Path to serviceAccountKey.json file downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option 2: JSON stringified service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Project ID
FIREBASE_PROJECT_ID=aravalli-sentinel

# Authority Registration Secret Token (Used by admins to provision authority accounts)
AUTHORITY_INVITE_SECRET=AravalliEnforce2025SecureToken

# Data Provider Mode: 'live' or 'demo'
ENVIRONMENTAL_DATA_MODE=demo
GEOSPATIAL_PROVIDER=sentinel-hub-simulator
